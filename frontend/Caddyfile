{$CADDY_ADDRESS} {
    encode zstd gzip

    handle_path /api/* {
        reverse_proxy backend:8000 {
            # Реальный IP клиента бэку — для slowapi rate-limit
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}
